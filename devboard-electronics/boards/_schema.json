{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware-electronics/board.schema.json",
  "title": "Board profile",
  "description": "Machine-readable board facts. Data, never prose. The reason this file type exists: GPIO 7 is a panel power-enable on the CrowPanel 2.13 v1 and a battery-sense input on the Heltec E290. An agent that greps a repo for 'GPIO 7' gets a confidently wrong answer, so the skill must never answer a pin question without a board ID.",
  "type": "object",
  "required": ["schema", "version", "id", "status", "family", "logic_v", "gpio_valid"],
  "properties": {
    "schema": { "const": "hardware-electronics/board" },
    "version": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "display_name": { "type": "string" },
    "status": {
      "description": "'superseded' profiles stay in the tree so their pin facts remain reachable, but the linter warns loudly when one is used.",
      "enum": ["active", "superseded", "draft"]
    },
    "superseded_by": { "type": ["string", "null"] },
    "family": { "type": "string" },
    "mcu": {
      "type": "object",
      "properties": {
        "family": { "type": "string" },
        "cores": { "type": ["integer", "null"] },
        "flash_mb": { "type": ["number", "null"] },
        "flash_mb_provenance": { "type": "string" },
        "psram_mb": { "type": ["number", "null"] },
        "psram_note": { "type": "string" }
      }
    },
    "fqbn": { "type": ["string", "null"] },
    "fqbn_note": { "type": "string" },
    "logic_v": { "type": "number" },

    "gpio_valid": { "type": "array", "items": { "type": "integer" } },
    "input_only": { "type": "array", "items": { "type": "integer" } },
    "strapping": { "type": "object", "additionalProperties": { "type": "string" } },
    "rtc_capable": { "type": "array", "items": { "type": "integer" } },
    "adc1": { "type": "object", "additionalProperties": { "type": "string" } },
    "adc2": { "type": "object", "additionalProperties": { "type": "string" } },
    "usb": { "type": "array", "items": { "type": "integer" } },
    "jtag": { "type": "array", "items": { "type": "integer" } },

    "consumed": {
      "description": "pin -> why it is not yours to allocate.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "free": {
      "description": "Authoritative free list when the vendor reference enumerates one. When present it OVERRIDES the derived list, because a pin can be unavailable for reasons no generic rule knows about.",
      "type": ["array", "null"],
      "items": { "type": "integer" }
    },
    "conditional_free": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "contradicted_header_pins": {
      "description": "Header pins the vendor documentation itself tells you not to use.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "onboard_i2c": {
      "type": "object",
      "properties": {
        "sda": { "type": "integer" },
        "scl": { "type": "integer" },
        "pullup_ohm": { "type": ["number", "null"] },
        "devices": { "type": "array", "items": { "type": "object" } }
      }
    },

    "power": {
      "type": "object",
      "properties": {
        "rails": { "type": "array", "items": { "type": "object" } },
        "charge": { "type": "object" },
        "battery_connector": { "type": "object" },
        "sleep_current_ua": { "type": "object" }
      }
    },

    "radio": {
      "type": "object",
      "properties": {
        "wifi": { "type": "boolean" },
        "ble": { "type": "boolean" },
        "lora": { "type": ["boolean", "object"] }
      }
    },

    "pin_notes": { "type": "object", "additionalProperties": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },

    "corroboration": {
      "description": "Why you should believe this profile: how many INDEPENDENT sources agree on each field group, what they disagree about, and what is unresolved. Authored and validated by the paired devboard-profiles skill. pinmap_lint.py warns (BOARD_UNCORROBORATED) when it is missing or thin, because a design validated against an unverified profile gets a confident answer built on nothing.",
      "type": "object"
    },

    "accepted_findings": {
      "description": "Advisory profile findings accepted on purpose, each with a written reason.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 10 }
    }
  }
}

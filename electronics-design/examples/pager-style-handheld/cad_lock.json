  "canonical": {
    "assembly": {
      "header_removal_note": "The 2x20 female header is removed late, after the board has been powered and identified. A board that has never been powered on should not be modified.",
      "header_removed": true
    },
    "assembly_order": [
      {
        "irreversible": false,
        "step": 1,
        "what": "Power and identify the bare board over USB; back up the factory flash.",
        "why_this_order": "A board that has never been powered on should not be modified, and factory firmware cannot be recovered after it is overwritten."
      },
      {
        "irreversible": false,
        "step": 2,
        "what": "Print and check the fit coupons for the speaker ring and the USB channel.",
        "why_this_order": "Ten minutes here saves a ten-hour mistake. Both features are press fits against parts whose dimensions were not originally measured."
      },
      {
        "irreversible": true,
        "step": 3,
        "what": "Remove the 2x20 header: cut the plastic body away, snip the stubs, then desolder pins one at a time.",
        "why_this_order": "Do this late, not early. Bulk-desoldering 40 through-hole pins at once lifts pads, and the board must be known good first."
      },
      {
        "irreversible": false,
        "step": 4,
        "what": "Kapton-tape the pin stubs before the cell goes anywhere near them.",
        "why_this_order": "A pouch cell against sharp pin stubs is a puncture risk."
      },
      {
        "irreversible": false,
        "step": 5,
        "what": "Meter the battery lead polarity, then fit the cell and close the back shell.",
        "why_this_order": "Last, because everything above needs the bay empty."
      }
    ],

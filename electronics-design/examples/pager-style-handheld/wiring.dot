digraph wiring {
  rankdir=LR;
  graph [splines=true, nodesep=0.5, ranksep=1.2, fontname="Segoe UI"];
  node  [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Segoe UI", fontsize=10];
  edge  [fontname="Segoe UI", fontsize=9];
  "mainboard" [label="mainboard\n3.3 V", shape=box3d];
  "amp" [label="amp\n3.3 V", shape=box];
  "mic" [label="mic\n3.3 V", shape=box];
  "haptic" [label="haptic\nI2C 0x5A\n3.3 V", shape=box];
  "expander" [label="expander\nI2C 0x20\n3.3 V", shape=box];
  "speaker" [label="speaker", shape=box];
  "motor" [label="motor", shape=box];
  "piezo" [label="piezo", shape=box];
  "battery" [label="battery", shape=box];
  "battery" -> "mainboard" [label="gnd\n- - GND", color="#212121", dir=none, penwidth=1.4];
  "mainboard" -> "amp" [label="gnd\nGND - GND", color="#212121", dir=none, penwidth=1.4];
  "amp" -> "mic" [label="gnd\nGND - GND", color="#212121", dir=none, penwidth=1.4];
  "mic" -> "haptic" [label="gnd\nGND - GND", color="#212121", dir=none, penwidth=1.4];
  "haptic" -> "expander" [label="gnd\nGND - GND", color="#212121", dir=none, penwidth=1.4];
  "expander" -> "piezo" [label="gnd\nGND - 2", color="#212121", dir=none, penwidth=1.4];
  "battery" -> "mainboard" [label="vbat\n+ - VBAT", color="#c62828", dir=none, penwidth=1.4];
  "mainboard" -> "amp" [label="vbat\nVBAT - VIN", color="#c62828", dir=none, penwidth=1.4];
  "mainboard" -> "mic" [label="v3v3\n3V3 - 3V3", color="#c62828", dir=none, penwidth=1.4];
  "mic" -> "haptic" [label="v3v3\n3V3 - VIN", color="#c62828", dir=none, penwidth=1.4];
  "haptic" -> "expander" [label="v3v3\nVIN - VCC", color="#c62828", dir=none, penwidth=1.4];
  "mainboard" -> "expander" [label="i2c_sda\n39 - SDA", color="#1565c0", dir=none, penwidth=1.4];
  "expander" -> "haptic" [label="i2c_sda\nSDA - SDA", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "expander" [label="i2c_scl\n38 - SCL", color="#1565c0", dir=none, penwidth=1.4];
  "expander" -> "haptic" [label="i2c_scl\nSCL - SCL", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "expander" [label="exp_int\n21 - INTA", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "mic" [label="mic_bclk\n41 - BCLK", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "mic" [label="mic_ws\n42 - WS", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "mic" [label="mic_sd\n40 - SD", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "amp" [label="amp_bclk\n47 - BCLK", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "amp" [label="amp_lrc\n48 - LRC", color="#1565c0", dir=none, penwidth=1.4];
  "mainboard" -> "amp" [label="amp_din\n17 - DIN", color="#1565c0", dir=none, penwidth=1.4];
  "amp" -> "speaker" [label="spk_p\nOUT+ - 1", color="#1565c0", dir=none, penwidth=1.4];
  "amp" -> "speaker" [label="spk_n\nOUT- - 2", color="#1565c0", dir=none, penwidth=1.4];
  "haptic" -> "motor" [label="motor_p\nOUT+ - 1", color="#1565c0", dir=none, penwidth=1.4];
  "haptic" -> "motor" [label="motor_n\nOUT- - 2", color="#1565c0", dir=none, penwidth=1.4];
  "expander" -> "piezo" [label="piezo_drive\nGPB0 - 1", color="#1565c0", dir=none, penwidth=1.4];
}
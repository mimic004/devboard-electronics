{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware-electronics/part.schema.json",
  "title": "Reusable peripheral definition",
  "description": "Geometry and electrical facts only - things that do not change. No pricing, no stock, no live sourcing: those go stale and would need network access at design time.",
  "type": "object",
  "required": ["schema", "version", "id", "description", "class"],
  "$defs": {
    "provenance": {
      "enum": ["assumed", "inferred", "seller_claimed", "vendor_claim", "simulated", "datasheet", "schematic", "measured"]
    }
  },
  "properties": {
    "schema": { "const": "hardware-electronics/part" },
    "version": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "description": { "type": "string" },
    "vendor": { "type": "string" },
    "sku": { "type": "string" },
    "mpn": { "type": "string" },
    "class": {
      "enum": ["pcb", "module", "sensor_module", "transducer", "battery", "switch", "display", "connector", "antenna", "motor", "magnet", "expander", "amplifier", "microphone", "haptic", "other"]
    },

    "footprint": {
      "type": "object",
      "properties": {
        "shape": { "enum": ["rect", "box", "circle", "cylinder", "polygon"] },
        "l": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "d": { "type": "number" },
        "height_includes": { "enum": ["body_only", "to_plunger_top", "to_shaft_top", "over_connector", "unknown"] },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenance" },
            { "type": "object", "additionalProperties": { "$ref": "#/$defs/provenance" } }
          ]
        }
      }
    },

    "electrical": { "type": "object" },
    "logic_v": { "type": "number" },
    "level_tolerant_5v": { "type": "boolean" },

    "i2c": {
      "type": "object",
      "properties": {
        "addresses": { "type": "array", "items": { "type": "string" } },
        "default": { "type": "string" },
        "address_select": { "type": "string" },
        "onboard_pullup_ohm": { "type": ["number", "null"] }
      }
    },

    "connector": { "type": "object" },
    "keepouts": { "type": "array", "items": { "type": "object" } },
    "orientation_constraint": { "type": "object" },
    "failure_mode": { "enum": ["loud", "silent", "degraded", "unknown"] },
    "liveness_check": { "type": "object" },
    "traps": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["active", "superseded", "draft"] },
    "corroboration": {
      "description": "Why you should believe this profile. Authored and validated by the paired board-profiles skill.",
      "type": "object"
    },
    "accepted_findings": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 10 }
    }
  }
}

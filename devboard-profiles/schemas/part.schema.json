{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devboard-profiles/part.schema.json",
  "title": "Part profile",
  "description": "Geometry and electrical facts only - things that do not change. No pricing, no stock, no live sourcing: those go stale and would need network access at design time. Plus the corroboration record that says why you should believe the numbers.",
  "type": "object",
  "required": ["schema", "version", "id", "description", "class"],
  "$defs": {
    "provenance": {
      "enum": ["assumed", "inferred", "seller_claimed", "vendor_claim", "simulated", "datasheet", "schematic", "measured"]
    }
  },
  "properties": {
    "schema": { "const": "hardware-electronics/part" },
    "version": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "description": { "type": "string" },
    "vendor": { "type": "string" },
    "sku": { "type": "string" },
    "mpn": { "type": "string" },
    "status": { "enum": ["active", "superseded", "draft"] },
    "class": {
      "enum": ["pcb", "module", "sensor_module", "transducer", "battery", "switch", "display", "connector", "antenna", "motor", "magnet", "expander", "amplifier", "microphone", "haptic", "other"]
    },

    "footprint": {
      "type": "object",
      "properties": {
        "shape": { "enum": ["rect", "box", "circle", "cylinder", "polygon"] },
        "l": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "d": { "type": "number" },
        "height_includes": {
          "description": "For W x L x H parts whose H may or may not include a plunger, boss or shaft. Declaring it is how the switch that turned out ~1.9 mm too tall gets caught.",
          "enum": ["body_only", "to_plunger_top", "to_shaft_top", "over_connector", "unknown"]
        },
        "provenance": {
          "oneOf": [
            { "$ref": "#/$defs/provenance" },
            { "type": "object", "additionalProperties": { "$ref": "#/$defs/provenance" } }
          ]
        }
      }
    },

    "electrical": { "type": "object" },
    "logic_v": { "type": "number" },
    "level_tolerant_5v": { "type": "boolean" },
    "pins_provided": { "type": "integer" },
    "interrupt": { "type": "object" },
    "bus": { "type": "object" },
    "radio": { "type": "object" },

    "i2c": {
      "type": "object",
      "properties": {
        "addresses": { "type": "array", "items": { "type": "string" } },
        "default": { "type": "string" },
        "address_select": {
          "description": "How the address is chosen, or a plain statement that it is fixed. A fixed address cannot be moved, so two of the part on one bus is a redesign.",
          "type": "string"
        },
        "onboard_pullup_ohm": {
          "description": "Record it even when the answer is null. A module that silently adds 10k makes the stacked-pull-up count wrong for every design that uses it.",
          "type": ["number", "null"]
        }
      }
    },

    "connector": { "type": "object" },
    "keepouts": { "type": "array", "items": { "type": "object" } },
    "openings": { "type": "array", "items": { "type": "object" } },
    "orientation_constraint": { "type": "object" },
    "mate": { "type": "object" },
    "serviceability": { "type": "object" },
    "access": { "type": "array", "items": { "type": "object" } },

    "failure_mode": { "enum": ["loud", "silent", "degraded", "unknown"] },
    "liveness_check": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "how": { "type": "string" }
      }
    },

    "traps": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },

    "corroboration": { "type": "object" },
    "accepted_findings": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 10 }
    }
  }
}

# Normalise line endings in the repository. CI runs on both ubuntu-latest and
# windows-latest, and several tools here compare tool output against expected
# strings - a stray CR is exactly the kind of difference that produces a
# confusing failure on one platform only.
* text=auto eol=lf

# Windows-only helpers keep CRLF so they behave when double-clicked.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Arduino sketches: LF, like the rest of the toolchain expects.
*.ino text eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.stl binary
*.3mf binary
*.bin binary
